<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" path="src" />
	<classpathentry kind="src" path="resources" />

	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true" />
		</attributes>
	</classpathentry>

	<!-- SQL Server -->
	<classpathentry kind="lib" path="lib/sqljdbc42.jar" />

	<!-- Webcam -->
	<classpathentry kind="lib" path="lib/webcam-capture-0.3.12.jar" />
	<classpathentry kind="lib" path="lib/bridj-0.7.0.jar" />
	<classpathentry kind="lib" path="lib/slf4j-api-1.7.2.jar" />

	<!-- ZXing Barcode -->
	<classpathentry kind="lib" path="lib/core-3.5.4.jar" />
	<classpathentry kind="lib" path="lib/javase-3.5.4.jar" />

	<classpathentry kind="output" path="bin" />
</classpath>